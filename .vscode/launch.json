{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "g++ build & debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.vscbuild/nvme.exe",
            //"args": ["list"],
            "args": ["id-ctrl","3"],
            // nvme create-ns /dev/nvme0 --nsze=6104741 --ncap=6104741 --flbas=0 -dps=0
            //"args": ["create-ns", "3", "--nsze=6104741", "--ncap=6104741", "--flbas=0", "-dps=0"],
            //"args": ["fw-commit", "3", "--action=1"],
            //"args": ["get-log", "2", "--log-id=0x08", "--log-len=512"], //get-log 2 --log-id=2 --log-len=4096
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [
                {
                    // Append the relative path to your DLLs directory to the PATH variable
                    "name": "PATH",
                    "value": "${env:PATH};${workspaceFolder}\\subprojects\\libnvme\\.vscbuild\\src"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe", // Adjust this path to your gdb.exe location
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Meson: build" // This should match a task label in tasks.json
        }
    ]
}